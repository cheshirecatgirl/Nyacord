{
  "name": "nyacord",
  "productName": "Nyacord",
  "version": "0.1.0",
  "description": "A hardened, portable, multi-channel desktop client for Discord (Stable / PTB / Canary).",
  "license": "MIT",
  "private": true,
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/bundle.mjs && node scripts/assets.mjs",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "test:e2e": "npm run build && node --test \"dist/test/e2e/*.e2e.js\"",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:packaged": "npm run dist:dir && node --test \"dist/test/packaged/*.test.js\""
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "^22.10.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.0"
  },
  "author": "cheshirecatgirl",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheshirecatgirl/Nyacord.git"
  },
  "build": {
    "appId": "app.nyacord.desktop",
    "productName": "Nyacord",
    "afterPack": "build/afterPack.cjs",
    "asar": true,
    "files": [
      "dist/src/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;InstantMessaging"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    }
  }
}
